{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "off",
    "no-await-in-loop": "off",
    "unicorn/prefer-dom-node-text-content": "off",
    "unicorn/no-array-callback-reference": "off"
  },
  "ignorePatterns": ["dist/**"]
}
